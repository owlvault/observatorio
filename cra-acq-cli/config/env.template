# =============================================================================
# VARIABLES DE ENTORNO — cra-acq-cli (Observatorio Regulatorio CRA)
# Copiar este archivo como .env en la estación o configurar en el sistema operativo
# =============================================================================

# --- IDENTIDAD DEL OPERADOR ---
CRA_OPERATOR_USER=operador_cra_titular

# --- CONEXIÓN SUI ORACLE (SSPD) VIA VPN ---
# Hostname o IP del servidor de base de datos Oracle del SUI
SUI_ORACLE_HOST=<HOST_SUI>
SUI_ORACLE_PORT=1521
SUI_ORACLE_SERVICE=<SERVICIO_SUI>
# Usuario nominal autorizado otorgado por la SSPD
SUI_ORACLE_USER=<USUARIO_SUI>
# NOTA DE SEGURIDAD: La contraseña NO se almacena aquí. Se solicita interactivamente en memoria.

# --- CONEXIÓN OCI AUTONOMOUS DATABASE (ADB) ---
# Nombre del servicio TNS configurado en el Wallet mTLS
ADB_TNS_NAME=cra_observatorio_high
ADB_USER=raw_control
ADB_PASSWORD=<CONTRASENA_RAW_CONTROL>
# Ruta a la carpeta descomprimida del Oracle Wallet (cwallet.sso, tnsnames.ora)
TNS_ADMIN=<RUTA_WALLET_ADB>

# --- ALMACENAMIENTO OCI OBJECT STORAGE (ZONA CRUDA) ---
OCI_BUCKET_NAME=cra-observatorio-raw
OCI_COMPARTMENT_ID=<OCID_COMPARTIMENTO>
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT

# --- PARÁMETROS OPERATIVOS ---
SUI_ORACLE_ARRAYSIZE=5000
DEFAULT_CHUNK_PROVIDER_SIZE=200
MAX_VPN_SESSION_HOURS=4
