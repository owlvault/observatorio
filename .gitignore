# ==============================================================================
# Gitignore - Observatorio Regulatorio CRA (Context Lake)
# ==============================================================================

# Archivos virtuales / accesos directos de Google Drive (causan error 'Invalid argument' en Git)
*.gdoc
*.gsheet
*.gslides
*.gform
*.gdraw
*.gtable

# Archivos del sistema operativo y metadatos de sincronización
desktop.ini
Thumbs.db
ehthumbs.db
.DS_Store
*.tmp
~$*

# Backups, versiones obsoletas y copias de conflicto de sincronización de Google Drive
*.superseded-*
* (1).*
* (2).*
* (3).*
* (4).*
* (5).*
* ([0-9]).*
* ([0-9][0-9]).*

# Salidas y paquetes temporales o externos de modelos/agentes
Claude outputs/*.zip

# IDEs y editores
.idea/
.vscode/
*.swp
*.swo

# Entornos virtuales Python o node_modules si llegasen a crearse
.venv/
env/
node_modules/
__pycache__/
*.pyc

# cra-acq-cli: la zona cruda vive en OCI Object Storage (ADR-0006, ADR-0007), nunca en git;
# este repositorio es público. Tampoco se versionan credenciales locales ni artefactos de empaquetado.
cra-acq-cli/storage_local_raw/
*.egg-info/
.env
