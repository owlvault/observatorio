      "description": "vocab/dominio_funcional.ttl",
      "constraints": {
       "enum": [
        "FINANCIERO Y CONTABLE",
        "TARIFARIO Y COSTOS",
        "INSTITUCIONAL Y HABILITACION",
        "CALIDAD DEL AGUA Y MUESTREO",
        "RIESGO Y GOBIERNO CORPORATIVO",
        "COMERCIAL Y FACTURACION",
        "TECNICO OPERATIVO",
        "OTROS",
        "SUBSIDIOS Y CONTRIBUCIONES",
        "INVERSIONES Y SGP",
        "PQR Y CONTROL SOCIAL",
        "ESTRATIFICACION Y TERRITORIO"
       ]
      }
     },
     {
      "name": "tipo_reporte",
      "type": "string",
      "description": "ESTRUCTURADO | DOCUMENTAL",
      "constraints": {
       "enum": [
        "ESTRUCTURADO",
        "DOCUMENTAL"
       ]
      }
     },
     {
      "name": "estado_vigencia",
      "type": "string",
      "description": "vocab/estado_vigencia.ttl",
      "constraints": {
       "enum": [
        "vigente-declarada",
        "vigente-parcial-verificar",
        "derogada-pendiente-reasignacion",
        "sin-norma"
       ]
      }
     },
     {
      "name": "n_tablas",
      "type": "integer",
      "description": "Tablas físicas asociadas"
     },
     {
      "name": "n_variables_documentadas",
      "type": "integer",
      "description": "Variables con cruce exacto (H11)"
     },
     {
      "name": "hallazgos",
      "type": "string",
      "description": "Ids de registro_calidad separados por ;"
     },
     {
      "name": "fuente",
      "type": "string",
      "description": "Procedencia"
     },
     {
      "name": "valido_desde",
      "type": "date",
      "description": "Inicio de vigencia"
     },
     {
      "name": "valido_hasta",
      "type": "date",
      "description": "Fin de vigencia"
     }
    ],
    "missingValues": [
     ""
    ],
    "primaryKey": [
