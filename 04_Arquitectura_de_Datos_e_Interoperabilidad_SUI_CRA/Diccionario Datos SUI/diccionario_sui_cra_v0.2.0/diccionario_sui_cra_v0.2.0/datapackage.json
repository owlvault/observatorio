  {
   "name": "variable_formato",
   "path": "data/variable_formato.csv",
   "title": "Variables (campos) por formato, según documento técnico",
   "description": "Nivel variable anclado al FORMATO del documento fuente, no a la columna física (H10). Usar calidad_correspondencia y requiere_validacion como filtros obligatorios.",
   "format": "csv",
   "mediatype": "text/csv",
   "encoding": "utf-8",
   "dialect": {
    "delimiter": ",",
    "header": true
   },
   "schema": {
    "fields": [
     {
      "name": "id_variable",
      "type": "string",
      "description": "Id estable VF-<hash8>(documento|formato|orden|nombre)",
      "constraints": {
       "required": true
      }
     },
     {
      "name": "id_documento",
      "type": "string",
      "description": "FK documento_tecnico"
     },
     {
      "name": "id_norma",
      "type": "string",
      "description": "FK norma (vacío si la norma no está en el catálogo del portal)"
     },
     {
      "name": "norma",
      "type": "string",
      "description": "Norma según documento"
     },
     {
      "name": "formato_segun_documento",
      "type": "string",
      "description": "Nombre del formato en el documento"
     },
     {
      "name": "orden",
      "type": "integer",
      "description": "Posición del campo en el formato"
     },
     {
      "name": "nombre_variable",
      "type": "string",
      "description": "Nombre del campo"
     },
     {
      "name": "definicion",
      "type": "string",
      "description": "Definición según documento (ISO 11179: definition)"
     },
     {
      "name": "tipo_dato_declarado",
      "type": "string",
      "description": "Literal original"
     },
     {
      "name": "tipo_dato_normalizado",
      "type": "string",
      "description": "vocab/tipo_dato.ttl",
      "constraints": {
       "enum": [
        "numerico",
        "entero",
        "decimal",
        "alfanumerico",
        "fecha",
        "hora",
        "codificado",
        "archivo",
        "sin-dato"
       ]
      }
     },
     {
      "name": "longitud",
      "type": "string",
      "description": "Longitud declarada (texto: puede ser rango)"
     },
     {
      "name": "unidad_medida",
      "type": "string",
      "description": "Unidad declarada"
     },
     {
      "name": "obligatoriedad_declarada",
      "type": "string",
      "description": "Literal original"
     },
     {
      "name": "obligatoriedad_normalizada",
      "type": "string",
      "description": "vocab/obligatoriedad.ttl",
      "constraints": {
       "enum": [
        "obligatorio",
        "condicional",
        "opcional",
        "sin-dato"
       ]
      }
     },
     {
      "name": "valores_admisibles",
      "type": "string",
      "description": "Dominio de valores (texto)"
     },
     {
      "name": "segmento_prestador",
      "type": "string",
      "description": "Segmento al que aplica (serie IUS)"
     },
     {
      "name": "observaciones",
      "type": "string",
      "description": "Reglas de validación y notas"
     },
     {
      "name": "id_formato_catalogo",
      "type": "string",
      "description": "Ids de formato del portal con cruce exacto, separados por ;"
     },
     {
      "name": "calidad_correspondencia",
      "type": "string",
      "description": "vocab/calidad_correspondencia.ttl",
      "constraints": {
       "enum": [
        "exacta",
        "sin-cruce"
       ]
      }
     },
     {
      "name": "clasificacion_sensibilidad",
      "type": "string",
      "description": "vocab/clasificacion_sensibilidad.ttl (propuesta, H13)",
      "constraints": {
       "enum": [
        "publico-propuesto",
        "restringido-propuesto"
       ]
      }
     },
     {
      "name": "motivo_clasificacion",
      "type": "string",
      "description": "Patrón que activó la clasificación"
     },
     {
      "name": "metodo_extraccion",
      "type": "string",
      "description": "PDF_TABLA | PDF_NARRATIVO | WEBFETCH_LECTOR",
      "constraints": {
       "enum": [
        "PDF_TABLA",
        "PDF_NARRATIVO",
        "WEBFETCH_LECTOR"
       ]
      }
     },
     {
      "name": "pagina",
      "type": "string",
      "description": "Página del PDF de la que se leyó"
     },
     {
      "name": "requiere_validacion",
      "type": "boolean",
      "description": "true si metodo_extraccion = WEBFETCH_LECTOR (H12)"
     },
     {
      "name": "hallazgos",
      "type": "string",
      "description": "Ids de registro_calidad"
     }
    ],
    "missingValues": [
     ""
    ],
    "primaryKey": [
     "id_variable"
    ],
    "foreignKeys": [
